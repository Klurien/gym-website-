# ── Paystack (Cards, Mobile Money, Bank Transfer) ──
# Get keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...

# ── M-Pesa (Safaricom Kenya) ──
# Get keys from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa/callback
# Set to 'production' for live, omit/any other value for sandbox
# MPESA_ENV=production